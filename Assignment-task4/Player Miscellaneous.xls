<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40"><head><!--[if gte mso 9]><xml><x:ExcelWorkbook><x:ExcelWorksheets><x:ExcelWorksheet><x:Name>Worksheet</x:Name><x:WorksheetOptions><x:DisplayGridlines/></x:WorksheetOptions></x:ExcelWorksheet></x:ExcelWorksheets></x:ExcelWorkbook></xml><![endif]--></head><body><table>
    
    

   
   <thead>

      
      <tr class="over_header">
         <th aria-label="" data-stat="" colspan="7" class=" over_header center"></th>
         <th aria-label="" data-stat="header_performance" colspan="12" class=" over_header center group_start">Performance</th><th></th>
      </tr>
            
      <tr>
         <th aria-label="Rk" data-stat="ranker" scope="col" class="tooltip ranker poptip sort_default_asc show_partial_when_sorting center" data-tip="&lt;strong&gt;Rank&lt;/strong&gt;&lt;br&gt;This is a count of the rows from top to bottom.&lt;br&gt;It is recalculated following the sorting of a column.">Rk</th>
         <th aria-label="Player" data-stat="player" scope="col" class=" poptip sort_default_asc left">Player</th>
         <th aria-label="Position" data-stat="position" scope="col" class=" poptip center" data-tip="&lt;strong&gt;Position&lt;/strong&gt;&lt;br&gt;Position most commonly played by the player&lt;br&gt;GK - Goalkeepers&lt;br&gt;DF - Defenders&lt;br&gt;MF - Midfielders&lt;br&gt;FW - Forwards&lt;br&gt;FB - Fullbacks&lt;br&gt;LB - Left Backs&lt;br&gt;RB - Right Backs&lt;br&gt;CB - Center Backs&lt;br&gt;DM - Defensive Midfielders&lt;br&gt;CM - Central Midfielders&lt;br&gt;LM - Left Midfielders&lt;br&gt;RM - Right Midfielders&lt;br&gt;WM - Wide Midfielders&lt;br&gt;LW - Left Wingers&lt;br&gt;RW - Right Wingers&lt;br&gt;AM - Attacking Midfielders&lt;br&gt;">Pos</th>
         <th aria-label="Squad" data-stat="team" scope="col" class=" poptip sort_default_asc center">Squad</th>
         <th aria-label="Age" data-stat="age" scope="col" class=" poptip sort_default_asc center" data-tip="Age at season start&lt;br&gt;Given on August 1 for winter leagues&lt;br&gt;and February 1 for summer leagues.">Age</th>
         <th aria-label="Year of birth" data-stat="birth_year" scope="col" class=" poptip center" data-tip="&lt;strong&gt;Year of birth&lt;/strong&gt;&lt;br&gt;">Born</th>
         <th aria-label="90s Played" data-stat="minutes_90s" scope="col" class=" poptip center" data-tip="&lt;strong&gt;90s Played&lt;/strong&gt;&lt;br&gt;&lt;strong&gt;90s played&lt;/strong&gt;&lt;br&gt;Minutes played divided by 90">90s</th>
         <th aria-label="Yellow Cards" data-stat="cards_yellow" scope="col" class=" poptip center group_start" data-tip="&lt;strong&gt;Yellow Cards&lt;/strong&gt;&lt;br&gt;Yellow Cards" data-over-header="Performance">CrdY</th>
         <th aria-label="Red Cards" data-stat="cards_red" scope="col" class=" poptip center" data-tip="&lt;strong&gt;Red Cards&lt;/strong&gt;&lt;br&gt;Red Cards" data-over-header="Performance">CrdR</th>
         <th aria-label="Second Yellow Card" data-stat="cards_yellow_red" scope="col" class=" poptip center" data-tip="&lt;strong&gt;Second Yellow Card&lt;/strong&gt;&lt;br&gt;Second Yellow Card" data-over-header="Performance">2CrdY</th>
         <th aria-label="Fouls Committed" data-stat="fouls" scope="col" class=" poptip center" data-tip="&lt;strong&gt;Fouls Committed&lt;/strong&gt;&lt;br&gt;Fouls Committed" data-over-header="Performance">Fls</th>
         <th aria-label="Fouls Drawn" data-stat="fouled" scope="col" class=" poptip center" data-tip="&lt;strong&gt;Fouls Drawn&lt;/strong&gt;&lt;br&gt;Fouls Drawn" data-over-header="Performance">Fld</th>
         <th aria-label="Offsides" data-stat="offsides" scope="col" class=" poptip center" data-tip="&lt;strong&gt;Offsides&lt;/strong&gt;&lt;br&gt;Offsides" data-over-header="Performance">Off</th>
         <th aria-label="Crosses" data-stat="crosses" scope="col" class=" poptip center" data-tip="&lt;strong&gt;Crosses&lt;/strong&gt;&lt;br&gt;Crosses" data-over-header="Performance">Crs</th>
         <th aria-label="Interceptions" data-stat="interceptions" scope="col" class=" poptip center" data-tip="&lt;strong&gt;Interceptions&lt;/strong&gt;&lt;br&gt;Interceptions" data-over-header="Performance">Int</th>
         <th aria-label="Tackles Won" data-stat="tackles_won" scope="col" class=" poptip center" data-tip="&lt;strong&gt;Tackles Won&lt;/strong&gt;&lt;br&gt;Tackles in which the tackler's team won possession of the ball" data-over-header="Performance">TklW</th>
         <th aria-label="Penalty Kicks Won" data-stat="pens_won" scope="col" class=" poptip center" data-tip="&lt;strong&gt;Penalty Kicks Won&lt;/strong&gt;&lt;br&gt;Penalty Kicks Won" data-over-header="Performance">PKwon</th>
         <th aria-label="Penalty Kicks Conceded" data-stat="pens_conceded" scope="col" class=" poptip center" data-tip="&lt;strong&gt;Penalty Kicks Conceded&lt;/strong&gt;&lt;br&gt;Penalty Kicks Conceded" data-over-header="Performance">PKcon</th>
         <th aria-label="Own Goals" data-stat="own_goals" scope="col" class=" poptip center" data-tip="&lt;strong&gt;Own Goals&lt;/strong&gt;&lt;br&gt;Own Goals" data-over-header="Performance">OG</th>
         <th aria-label="Matches" data-stat="matches" scope="col" class=" poptip center group_start">Matches</th>
      </tr>
      </thead>
